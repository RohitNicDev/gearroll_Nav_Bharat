# Copy to .env and replace with Firebase Console > Project settings > Your apps > Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Enable Google Analytics in Firebase, then copy the web app measurement ID (G-XXXXXXXXXX).
VITE_FIREBASE_MEASUREMENT_ID=

# Match the Cloud Functions region in functions/index.js.
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Optional legacy/common API base URL for non-enquiry APIs.
VITE_API_BASE_URL=
